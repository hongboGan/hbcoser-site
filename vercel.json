{
  "cleanUrls": true,
  "redirects": [
    { "source": "/products", "destination": "/shop", "permanent": true }
  ],
  "headers": [
    {
      "source": "/analytics-bootstrap.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(banners|categories|custom|factory|products|reviews|fonts|gallery-responsive)/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
